{
  "name": "btl16-realtime-auction",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/dev-runner.mjs",
    "dev:server": "node tools/dev-runner.mjs --server-only",
    "client": "node tools/client-runner.mjs",
    "build": "mvn -q -DskipTests package dependency:copy-dependencies -DincludeScope=runtime",
    "test": "scripts\\run-self-tests.cmd",
    "dist:client": "node tools/package-client.mjs",
    "dist:server": "node tools/package-server.mjs",
    "dist:mac:portable": "node tools/package-mac-portable.mjs",
    "test:packaging": "node --test tools/package-layout.test.mjs",
    "dist": "node tools/package-desktop.mjs"
  }
}
